<?xml version="1.0" encoding="UTF-8"?>
<!-- Imported into the commercewebservices web context by
     <import resource="classpath*:/occ/v2/*occ/web/spring/*-web-spring.xml"/> -->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Who the caller is: the B2B customer, the company's customer number and its Sales and Service Cloud account. -->
    <bean id="casiCustomerContext" class="com.casi.serviceocc.CustomerContext">
        <property name="userService" ref="userService"/>
        <property name="sscClient" ref="casiSscCaseClient"/>
    </bean>

    <bean id="casiSscTicketsController" class="com.casi.serviceocc.controllers.SscTicketsController">
        <property name="customerContext" ref="casiCustomerContext"/>
        <property name="sscClient" ref="casiSscCaseClient"/>
    </bean>

    <!-- casiS4ODataClient is the S/4 OData client of the casireturnsocc extension. -->
    <bean id="casiSelfServiceController" class="com.casi.serviceocc.controllers.SelfServiceController">
        <property name="customerContext" ref="casiCustomerContext"/>
        <property name="sscClient" ref="casiSscCaseClient"/>
        <property name="s4Client" ref="casiS4ODataClient"/>
    </bean>
</beans>
