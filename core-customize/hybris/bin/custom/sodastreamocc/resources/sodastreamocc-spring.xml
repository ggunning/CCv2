<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- The interface is the contract; swap the class to change the implementation. -->
    <alias name="defaultSodastreamService" alias="sodastreamService"/>
    <bean id="defaultSodastreamService" class="com.sodastream.occ.service.impl.DefaultSodastreamService">
        <property name="baseSiteService" ref="baseSiteService"/>
    </bean>
</beans>
