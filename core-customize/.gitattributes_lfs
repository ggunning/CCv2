# Customizing impex files
*customizing.impex              filter=lfs diff=lfs merge=lfs -text

# Never include customizing stuff since LFS is initialized after ant customize
# This will only be possible when SAP finally installs git-lfs in their build images
# This always has to stay at the bottom of the .gitattributes!
_CUSTOMIZE_/**                filter= diff= merge= text
_CUSTOMIZE_/**/*.jar          filter= diff= merge= binary
# The gradle wrapper needs to be excluded from LFS as well
**/gradle/wrapper/gradle-wrapper.jar filter= diff= merge= binary